# Copy to .env and fill in. Leave empty to keep tracking fully disabled.
# In production, set these in Cloudflare Pages → Settings → Environment variables.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Tracklution container ID, e.g. LS-00000000-0
PUBLIC_TRACKLUTION_ID=


# Sanity (Phase 4)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Cloudflare Turnstile (spam protection on the contact form). Public site key only;
# the secret goes to the Worker: npx wrangler secret put TURNSTILE_SECRET_KEY
PUBLIC_TURNSTILE_SITE_KEY=
