{
  // Static site on Cloudflare (Workers static assets). The Worker in worker/index.ts runs ONLY for
  // /api/* (contact form); every page and asset is served directly without invoking it.
  // _headers and _redirects in public/ are applied by Cloudflare automatically.
  // Deploy: npm run deploy
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heseven-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "vars": {
    // TEMPORARY: Resend's test sender can only deliver to the Resend account owner's address.
    // Switch back to info@heseven.com once heseven.com is verified in Resend (and update CONTACT_FROM).
    "CONTACT_TO": "heseven07@gmail.com",
    // Until heseven.com is verified in Resend, Resend only allows this sender.
    "CONTACT_FROM": "Heseven Website <onboarding@resend.dev>",
  },
  // Secrets (never commit): npx wrangler secret put RESEND_API_KEY / TURNSTILE_SECRET_KEY
  "observability": { "enabled": true },
}
