---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Process from '../../components/sections/Process.astro';
import Cta from '../../components/sections/Cta.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { services } from '../../data/home';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const schema = [
  {
    '@type': 'Service',
    name: service.title,
    description: service.summary,
    provider: { '@id': `${SITE.url}/#organization` },
    url,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services/` },
      { '@type': 'ListItem', position: 3, name: service.title, item: url },
    ],
  },
];
---

<BaseLayout title={`${service.title} — Shopify`} description={service.summary}>
  <PageHero eyebrow="Service" title={service.title} lead={service.summary}>
    <a href="/contact/" class="btn btn-primary btn-lg mt-10">
      Get a quote
    </a>
  </PageHero>
  <!-- Phase 3: full service page content (from Sanity) -->
  <Process />
  <Cta />
  <JsonLd data={schema} />
</BaseLayout>
