---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/layout/PageHero.astro';
import PostCard from '../../../../components/blog/PostCard.astro';
import TopicFilter from '../../../../components/blog/TopicFilter.astro';
import PreloadSanityImage from '../../../../components/blog/PreloadSanityImage.astro';
import Cta from '../../../../components/sections/Cta.astro';
import { getAllPosts, getAllCategories } from '../../../../lib/sanity';

export async function getStaticPaths() {
  const [posts, categories] = await Promise.all([getAllPosts(), getAllCategories()]);
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      categories,
      posts: posts.filter((p) => p.categories.some((c) => c.slug === category.slug)),
    },
  }));
}

const { category, categories, posts } = Astro.props;
---

<BaseLayout
  title={`${category.title} — Shopify Blog`}
  description={
    category.description ?? `Heseven articles about ${category.title.toLowerCase()} for Shopify brands.`
  }
>
  {posts[0] && (
    <PreloadSanityImage
      slot="head"
      image={posts[0].mainImage}
      width={960}
      ratio={16 / 9}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
    />
  )}
  <PageHero eyebrow="Blog category" title={category.title} lead={category.description}>
    <TopicFilter categories={categories} active={category.slug} />
  </PageHero>
  <section class="container-x pb-24 md:pb-32" aria-label="Posts">
    <ul class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => (
        <li data-reveal style={`--reveal-delay:${(i % 3) * 80}`}>
          <PostCard post={p} eager={i === 0} />
        </li>
      ))}
    </ul>
  </section>
  <Cta />
</BaseLayout>
