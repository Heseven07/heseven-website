---
/**
 * Website terms of use. They cover use of heseven.com only; client projects run under their own
 * written agreement (see "Our services and quotes").
 */
import LegalPage, { type LegalSection } from '../components/layout/LegalPage.astro';
import { SITE } from '../config/site';

const a = SITE.address;
const address = `${SITE.legalName}, ${a.streetAddress}, ${a.addressLocality} ${a.postalCode}, United Kingdom`;
const mail = `<a href="mailto:${SITE.email}">${SITE.email}</a>`;

const sections: LegalSection[] = [
  {
    id: 'about',
    title: 'About these terms',
    html: `<p>These terms apply to your use of heseven.com, which is run by ${address} (“Heseven”, “we”, “us”). By using the website you agree to them. If you don't agree, please don't use the site.</p>`,
  },
  {
    id: 'using-the-site',
    title: 'Using the website',
    html: `<p>You may browse the website, share links to it and use its content for your own information. You must not:</p>
<ul>
<li>use the website in any way that breaks the law or harms anyone;</li>
<li>try to gain unauthorised access to the website, its servers or any connected systems;</li>
<li>introduce viruses or other harmful code, or overload the site with automated requests;</li>
<li>submit false, spam or misleading enquiries through our forms; or</li>
<li>copy large parts of the website, or scrape it, for commercial use without our written permission.</li>
</ul>`,
  },
  {
    id: 'services-and-quotes',
    title: 'Our services and quotes',
    html: `<p>The information on this website about our services, processes and typical timelines is general and for guidance only. It is not an offer.</p>
<p>Any quote or proposal we send is not binding until both sides have signed a written agreement or statement of work. Each project is governed by that agreement, which takes priority over anything on this website.</p>`,
  },
  {
    id: 'case-studies',
    title: 'Case studies and results',
    html: `<p>Our case studies and examples describe real work for real clients. Every business is different, so results achieved for one client are not a promise of the same results for another.</p>`,
  },
  {
    id: 'intellectual-property',
    title: 'Intellectual property',
    html: `<p>The design, text, graphics, code and other content of this website belong to Heseven or our licensors and are protected by copyright and other laws. “Heseven” and our logo are our trade marks.</p>
<p>Client names, logos and store screenshots belong to their respective owners and are shown to illustrate our work. Shopify and Shopify Plus are trade marks of Shopify Inc.</p>`,
  },
  {
    id: 'links',
    title: 'Links to other websites',
    html: `<p>Our website links to other sites, including our clients' stores. We don't control those sites and aren't responsible for their content, availability or privacy practices.</p>`,
  },
  {
    id: 'availability',
    title: 'Availability and accuracy',
    html: `<p>We work to keep the website available and up to date, but we can't guarantee it will always be available, uninterrupted or free of errors. We may change or remove any part of it at any time.</p>`,
  },
  {
    id: 'liability',
    title: 'Our liability',
    html: `<p>The website is provided free of charge and “as is”. To the extent the law allows, we are not liable for any loss arising from your use of it or reliance on its content, including indirect or consequential loss, or loss of profit, business or data.</p>
<p>Nothing in these terms limits or excludes liability that cannot be limited or excluded by law, including liability for death or personal injury caused by negligence, or for fraud.</p>`,
  },
  {
    id: 'privacy',
    title: 'Your privacy',
    html: `<p>Our <a href="/privacy">Privacy Policy</a> explains how we use personal data you give us through the website and how we use cookies.</p>`,
  },
  {
    id: 'changes',
    title: 'Changes to these terms',
    html: `<p>We may update these terms from time to time. The date at the top of this page shows when they were last changed. Please check them whenever you use the website.</p>`,
  },
  {
    id: 'law',
    title: 'Governing law',
    html: `<p>These terms are governed by the law of England and Wales, and the courts of England and Wales have exclusive jurisdiction over any dispute about them.</p>`,
  },
  {
    id: 'contact',
    title: 'Contact us',
    html: `<p>Questions about these terms? Email us at ${mail}.</p>`,
  },
];
---

<LegalPage
  title="Terms of Use"
  description="The terms of use for heseven.com, the website of Heseven Ltd, a Shopify Partner agency based in London."
  lead="The rules for using heseven.com. Client projects are covered by their own written agreement."
  updated="27 October 2026"
  sections={sections}
/>
