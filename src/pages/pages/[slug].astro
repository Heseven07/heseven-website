---
/**
 * Landing pages from Sanity at /pages/<slug> — the same URL structure as Shopify.
 * Static routes in this folder (contact-us, services, thank-you) take precedence over this one.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Sections from '../../components/page-builder/Sections.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { getAllLandingPages, imageUrl, type LandingPage } from '../../lib/sanity';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const pages = await getAllLandingPages();
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: LandingPage };
const url = new URL(`/pages/${page.slug}`, Astro.site).href;
const hasHero = page.sections[0]?._type === 'sectionHero';
// Migrated pages keep Shopify's "<title> – Heseven" format; new pages use "<title> | Heseven".
const baseTitle = (page.seo?.title ?? page.title).trim();
const pageTitle = page.legacy ? `${baseTitle} – ${SITE.name}` : `${baseTitle} | ${SITE.name}`;
const hero = page.sections.find((s) => s._type === 'sectionHero') as { lead?: string } | undefined;
const description = page.seo?.description ?? hero?.lead ?? SITE.description;
const shareImage = page.seo?.ogImage
  ? imageUrl(page.seo.ogImage).width(1200).height(630).fit('crop').format('jpg').url()
  : undefined;

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: baseTitle,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: page.title, item: url },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  rawTitle
  description={description}
  image={shareImage}
  noindex={page.seo?.noindex}
>
  {!hasHero && <PageHero title={page.title} lead={page.seo?.description} />}
  <Sections sections={page.sections} title={page.title} />
  <JsonLd data={schema} />
</BaseLayout>
