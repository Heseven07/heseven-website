---
/**
 * Landing pages from Sanity at /pages/<slug> — the same URL structure as Shopify.
 * Static routes in this folder (contact-us, thank-you) take precedence over this one.
 */
import BuilderPage from '../../components/page-builder/BuilderPage.astro';
import { getAllLandingPages, type LandingPage } from '../../lib/sanity';

export async function getStaticPaths() {
  const pages = await getAllLandingPages();
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: LandingPage };
---

<BuilderPage page={page} base="pages" />
