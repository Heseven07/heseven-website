---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for doesn't exist." noindex>
  <section class="container-x flex min-h-[70dvh] flex-col items-start justify-center gap-6 py-24">
    <p class="font-display text-lime text-sm tracking-[0.2em] uppercase">Error 404</p>
    <h1 class="text-5xl font-bold sm:text-6xl">This page took a detour.</h1>
    <a href="/" class="btn btn-primary">
      Back to home
    </a>
  </section>
</BaseLayout>
