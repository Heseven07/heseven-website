---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import NextSteps from '../components/contact/NextSteps.astro';
import ContactDetails from '../components/contact/ContactDetails.astro';
import ClientMarquee from '../components/sections/ClientMarquee.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Faq from '../components/sections/Faq.astro';
import GlobalClocks from '../components/sections/GlobalClocks.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { SITE } from '../config/site';

const schema = {
  '@type': 'ContactPage',
  name: 'Contact Heseven',
  url: `${SITE.url}/contact`,
  about: { '@id': `${SITE.url}/#organization` },
};
---

<BaseLayout
  title="Contact — Get a Shopify Project Quote"
  description="Tell us about your Shopify project. A Heseven strategist replies within one business day with next steps, a free scoping call and a fixed-price quote."
>
  <ContactHero />
  <ClientMarquee />
  <NextSteps />
  <Testimonials />
  <Faq />
  <GlobalClocks />
  <ContactDetails />
  <JsonLd data={schema} />
</BaseLayout>
