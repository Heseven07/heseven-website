---
/**
 * Sanity image → Astro <Image>. Sanity crops to the requested aspect ratio (respecting the editor's
 * hotspot), then Astro downloads it at build time and emits responsive AVIF/WebP from our own domain.
 */
import { Picture } from 'astro:assets';
import type { SanityImage } from '../../lib/sanity';
import { sanityImageOptions } from '../../lib/sanity-image';

interface Props {
  image: SanityImage;
  /** Output width of the largest rendition. */
  width: number;
  /** Aspect ratio (w/h). Omit to keep the original ratio. */
  ratio?: number;
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
  alt?: string;
}
const {
  image,
  width,
  ratio,
  sizes,
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  alt,
} = Astro.props;
const { src, height, widths } = sanityImageOptions(image, width, ratio);
---

<Picture
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  src={src}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  alt={alt ?? image.alt ?? ''}
  loading={loading}
  fetchpriority={fetchpriority}
  class={className}
/>
