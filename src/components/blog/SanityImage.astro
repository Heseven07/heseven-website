---
/**
 * Sanity image → Astro <Image>. Sanity crops to the requested aspect ratio (respecting the editor's
 * hotspot), then Astro downloads it at build time and emits responsive AVIF/WebP from our own domain.
 */
import { Image } from 'astro:assets';
import { imageUrl, type SanityImage } from '../../lib/sanity';

interface Props {
  image: SanityImage;
  /** Output width of the largest rendition. */
  width: number;
  /** Aspect ratio (w/h). Omit to keep the original ratio. */
  ratio?: number;
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
  alt?: string;
}
const {
  image,
  width,
  ratio,
  sizes,
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  alt,
} = Astro.props;
const dims = image.asset.metadata.dimensions;
const height = Math.round(width / (ratio ?? dims.width / dims.height));
const src = imageUrl(image).width(width).height(height).fit('crop').url();
const widths = [480, 720, 960, 1280, 1600].filter((w) => w < width).concat(width);
---

<Image
  src={src}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  alt={alt ?? image.alt ?? ''}
  loading={loading}
  fetchpriority={fetchpriority}
  class={className}
/>
