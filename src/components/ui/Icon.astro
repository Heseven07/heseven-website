---
/**
 * Self-drawing line icon (no library, zero JS).
 * The stroke draws in when an ancestor gets `.is-visible` (scroll reveal) and redraws on `.group:hover`.
 * `d` is a 24×24 stroke path — see `icons` in src/data/icons.ts.
 */
interface Props {
  d: string;
  size?: number;
  class?: string;
}
const { d, size = 22, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['icon-draw', className]}
>
  <path d={d} pathLength="1"></path>
</svg>
