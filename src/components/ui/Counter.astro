---
/**
 * Number that counts up when scrolled into view (see src/scripts/counters.ts).
 * Pass the final display string, e.g. "1000+", "−45%", "2.1×", "5 wks", "2018".
 * The final value is server-rendered, so crawlers / no-JS / reduced-motion users see it as-is.
 */
interface Props {
  value: string;
  /** Start value; defaults to 0, or value − 10 for years (1900–2100). */
  from?: number;
  class?: string;
}
const { value, from, class: className = '' } = Astro.props;
const match = value.match(/^([^\d]*)(\d+(?:\.\d+)?)(.*)$/);
const to = match ? Number(match[2]) : null;
const decimals = match?.[2]?.split('.')[1]?.length ?? 0;
const start = from ?? (to !== null && decimals === 0 && to >= 1900 && to <= 2100 ? to - 10 : 0);
---

{match ? (
  <span
    class:list={['counter', className]}
    data-counter
    data-to={to}
    data-from={start}
    data-decimals={decimals}
    data-prefix={match[1]}
    data-suffix={match[3]}
  >
    {value}
  </span>
) : (
  <span class={className}>{value}</span>
)}
