---
import SectionHeading from '../ui/SectionHeading.astro';
import { whyUs } from '../../data/home';
---

<section class="container-x py-24 md:py-32" aria-labelledby="why-title">
  <SectionHeading id="why-title" eyebrow={whyUs.eyebrow} title={whyUs.title} />
  <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
    {whyUs.pillars.map((p, i) => (
      <li
        class:list={['card p-8', i < 2 ? 'lg:col-span-3' : 'lg:col-span-2', i === 0 && 'card-accent']}
        data-reveal
        style={`--reveal-delay:${(i % 3) * 80}`}
      >
        <h3 class="text-2xl font-semibold">{p.title}</h3>
        <p class="mt-3 text-muted">{p.body}</p>
      </li>
    ))}
  </ul>
</section>
