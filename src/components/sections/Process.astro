---
import SectionHeading from '../ui/SectionHeading.astro';
import { process } from '../../data/home';
---

<!--
  Desktop: section pins while a line draws 1 → 5, lighting each step, then releases.
  Mobile: vertical line fills as you scroll. Logic: src/scripts/process.ts
-->
<section
  id="process"
  class="process-section scroll-mt-24 bg-ink-2"
  aria-labelledby="process-title"
  data-process
>
  <div class="process-pin">
    <div class="container-x w-full py-24 md:py-0">
      <SectionHeading id="process-title" eyebrow={process.eyebrow} title={process.title} />
      <div class="process-track relative mt-16">
        <div class="process-line" aria-hidden="true">
          <span class="process-line-fill"></span>
        </div>
        <ol class="grid gap-12 md:grid-cols-5 md:gap-0">
          {process.steps.map((s, i) => (
            <li class="process-step md:pr-6">
              <span class="process-dot" aria-hidden="true">
                {i + 1}
              </span>
              <div class="process-body">
                <h3 class="text-xl font-semibold">{s.title}</h3>
                <p class="mt-2 text-muted">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
