---
/**
 * "How we work" — stacking cards. On desktop the heading stays put on the left while each step's card
 * slides up and parks on top of the previous one (CSS position: sticky, a little lower each time), so
 * the stack builds as you scroll. No JavaScript; on phones it's a plain list of the same cards.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { process } from '../../data/home';

const n = process.steps.length;
const pad = (i: number) => String(i).padStart(2, '0');
---

<section id="process" class="scroll-mt-24 bg-ink-2 py-24 md:py-32" aria-labelledby="process-title">
  <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <div class="pr-intro">
        <SectionHeading
          id="process-title"
          eyebrow={process.eyebrow}
          title={process.title}
          lead={process.lead}
        />
        <ol class="pr-index" aria-hidden="true">
          {process.steps.map((s, i) => (
            <li>
              <span>{pad(i + 1)}</span>
              {s.title}
            </li>
          ))}
        </ol>
      </div>
    </div>

    <ol class="pr-stack lg:col-span-7">
      {process.steps.map((s, i) => (
        <li class="pr-item" style={`--i:${i}`}>
          <article class="pr-card" data-reveal>
            <span class="pr-ghost" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <header class="pr-top">
              <span class="pr-step">
                Step {pad(i + 1)}
                <span class="text-muted"> / {pad(n)}</span>
              </span>
              <span class="pr-icon" aria-hidden="true">
                <Icon d={s.icon} />
              </span>
            </header>
            <h3 class="pr-title">{s.title}</h3>
            <p class="pr-body">{s.body}</p>
            <p class="pr-deliverable">
              <span class="pr-deliverable-label">You get</span>
              {s.deliverable}
            </p>
            <span class="pr-bar" aria-hidden="true">
              {process.steps.map((_, j) => (
                <i class:list={[j <= i && 'is-on']} />
              ))}
            </span>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pr-index {
    display: none;
  }
  @media (min-width: 1024px) {
    .pr-intro {
      position: sticky;
      top: 8rem;
    }
    .pr-index {
      display: grid;
      gap: 0.25rem;
      margin-top: 2.5rem;
      color: var(--color-muted);
    }
    .pr-index li {
      display: flex;
      gap: 1rem;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--color-line);
    }
    .pr-index span {
      font-family: var(--font-display);
      font-size: 0.85rem;
      color: var(--color-lime);
    }
  }

  .pr-stack {
    display: grid;
    gap: 1.25rem;
  }
  /* Desktop: each card parks a little lower than the last, so the stack's edges show. */
  @media (min-width: 768px) {
    .pr-stack {
      gap: 2rem;
    }
    .pr-item {
      position: sticky;
      top: calc(7.5rem + var(--i) * 1.5rem);
    }
  }

  .pr-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 2rem;
    border-radius: 1.75rem;
    border: 1px solid var(--color-line);
    background:
      radial-gradient(90% 80% at 100% 0%, rgb(139 108 255 / 0.16), transparent 60%),
      radial-gradient(70% 70% at 0% 100%, rgb(181 243 107 / 0.07), transparent 60%), var(--color-ink-3);
    box-shadow: 0 -20px 50px -30px rgb(0 0 0 / 0.9);
    transition: border-color 0.4s;
  }
  @media (min-width: 768px) {
    .pr-card {
      min-height: 21rem;
      padding: 2.75rem;
    }
  }
  .pr-card:hover {
    border-color: rgb(181 243 107 / 0.35);
  }
  /* Big outlined step number behind the content. */
  .pr-ghost {
    position: absolute;
    right: -0.5rem;
    bottom: -2.5rem;
    z-index: -1;
    font-family: var(--font-display);
    font-size: clamp(8rem, 18vw, 14rem);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.08);
  }
  .pr-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .pr-step {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgb(181 243 107 / 0.35);
    background: rgb(181 243 107 / 0.08);
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--color-lime);
  }
  .pr-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    background: var(--color-lime);
    color: var(--color-ink);
    box-shadow: 0 0 30px rgb(181 243 107 / 0.3);
  }
  .pr-title {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
  }
  .pr-body {
    max-width: 34rem;
    margin-top: 0.85rem;
    color: var(--color-muted);
    font-size: 1.05rem;
  }
  .pr-deliverable {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0.5rem 0.9rem 0.5rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: rgb(11 10 16 / 0.5);
    font-size: 0.9rem;
  }
  .pr-deliverable-label {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgb(139 108 255 / 0.25);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  /* Progress through the five steps. */
  .pr-bar {
    display: flex;
    gap: 0.35rem;
    margin-top: 2rem;
  }
  .pr-bar i {
    flex: 1;
    height: 4px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.1);
  }
  .pr-bar i.is-on {
    background: linear-gradient(90deg, var(--color-violet), var(--color-lime));
  }
</style>
