---
/**
 * Selected work — horizontal 3D roll. Three cards are in view at once on desktop; the track is a real
 * horizontal scroller, and each card rolls on a drum (rotateY + scale) from its position in it via a CSS
 * scroll-driven `view(inline)` timeline, so the 3D runs on the compositor.
 *   Desktop (md+, JS): the section pins and vertical page scroll drives the track sideways (work-roll.ts).
 *   Mobile / no JS: native swipe with scroll-snap.
 * Mouse tilt + glare on the screenshot frame come from interactions.ts ([data-tilt]).
 */
import { Picture } from 'astro:assets';
import Counter from '../ui/Counter.astro';
import { work } from '../../data/home';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="work" class="work-pin scroll-mt-24" aria-labelledby="work-title" data-work-pin>
  <div class="work-sticky">
    <div class="container-x flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-title" class="mt-4 text-4xl font-bold sm:text-5xl">
          Work we're proud of.
        </h2>
        <p class="mt-4 text-lg text-muted">Real stores, measurable outcomes.</p>
      </div>
      <div class="flex items-center gap-4 text-sm text-muted" aria-hidden="true">
        <span class="font-display text-fg">01</span>
        <span class="work-progress">
          <span class="work-progress-bar" data-work-progress></span>
        </span>
        <span class="font-display">{pad(work.length)}</span>
      </div>
    </div>

    <ul class="work-track" data-work-track>
      {work.map((w, i) => {
        // Whole card links to the live store when one is available.
        const Wrapper = w.url ? 'a' : 'div';
        const host = w.url ? new URL(w.url).hostname.replace(/^www\./, '') : undefined;
        const linkProps = w.url
          ? {
              href: w.url,
              target: '_blank',
              rel: 'noopener',
              'aria-label': `${w.client}: ${w.metric} ${w.metricLabel.toLowerCase()} — visit the live store (opens in a new tab)`,
            }
          : {};
        return (
          <li class="work-item">
            <article
              class:list={['work-card group', i % 2 ? 'work-card--lime' : 'work-card--violet']}
              data-tilt
            >
              <Wrapper class="block p-3" {...linkProps}>
                <div class="work-media">
                  <div class="work-bar" aria-hidden="true">
                    <span class="work-dot" />
                    <span class="work-dot" />
                    <span class="work-dot" />
                    <span class="work-url">{host ?? `${w.slug}.myshopify.com`}</span>
                  </div>
                  <div class="relative overflow-hidden">
                    <Picture
                      src={w.image}
                      alt={`${w.client} Shopify store homepage`}
                      widths={[400, 600, 900]}
                      sizes="(min-width: 768px) 30rem, 85vw"
                      formats={['avif', 'webp']}
                      class="work-img aspect-[16/10] w-full object-cover object-top"
                    />
                    <span class="work-glare" aria-hidden="true" />
                    <span class="work-chip">{w.sector}</span>
                  </div>
                </div>
                <div class="flex items-end justify-between gap-4 px-3 pt-5 pb-3">
                  <div class="min-w-0">
                    <p class="font-display text-sm text-muted">{pad(i + 1)}</p>
                    <h3 class="mt-1 truncate font-display text-2xl font-bold tracking-tight transition-colors group-hover:text-lime">
                      {w.client}
                    </h3>
                    {host ? (
                      <p class="mt-1 text-sm text-fg/60">{host} ↗</p>
                    ) : (
                      <p class="mt-1 text-sm text-fg/60">{w.sector}</p>
                    )}
                  </div>
                  <p class="shrink-0 text-right">
                    <span class="block font-display text-4xl font-bold text-lime">
                      <Counter value={w.metric} />
                    </span>
                    <span class="text-sm text-muted">{w.metricLabel}</span>
                  </p>
                </div>
              </Wrapper>
            </article>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  import { initWorkRoll } from '../../scripts/work-roll';
  document.addEventListener('astro:page-load', initWorkRoll);
</script>
