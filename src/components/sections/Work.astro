---
import { Picture } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Counter from '../ui/Counter.astro';
import { work } from '../../data/home';
---

<section id="work" class="container-x scroll-mt-24 py-24 md:py-32" aria-labelledby="work-title">
  <SectionHeading
    id="work-title"
    eyebrow="Selected work"
    title="Work we're proud of."
    lead="Real stores, measurable outcomes."
  />
  <ul class="work-grid mt-14 grid gap-x-6 gap-y-14 md:grid-cols-2">
    {work.map((w, i) => {
      // Whole card links to the live store when one is available.
      const Wrapper = w.url ? 'a' : 'div';
      const linkProps = w.url
        ? {
            href: w.url,
            target: '_blank',
            rel: 'noopener',
            'aria-label': `${w.client}: ${w.metric} ${w.metricLabel.toLowerCase()} — visit the live store (opens in a new tab)`,
          }
        : {};
      return (
        <li class:list={['reveal-3d', i % 2 === 1 && 'md:translate-y-24']} data-reveal>
          <article class="work-card group" data-tilt>
            <Wrapper class="block" {...linkProps}>
              <div class="work-media">
                <Picture
                  src={w.image}
                  alt={`${w.client} Shopify store homepage`}
                  widths={[480, 720, 960, 1200]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  formats={['avif', 'webp']}
                  class="work-img aspect-[4/3] w-full object-cover object-top"
                />
                <span class="work-glare" aria-hidden="true" />
                <span class="work-chip">{w.sector}</span>
                {w.url && (
                  <span class="work-cursor" aria-hidden="true">
                    Visit live site
                    <svg
                      viewBox="0 0 24 24"
                      width="14"
                      height="14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                    >
                      <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                )}
              </div>
              <div class="mt-6 flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-2xl font-semibold transition-colors group-hover:text-lime">{w.client}</h3>
                  <p class="mt-1 text-sm text-muted">
                    {w.sector}
                    {w.url && (
                      <span class="block text-fg/60 sm:ml-2 sm:inline">
                        <span class="hidden sm:inline">· </span>
                        {new URL(w.url).hostname.replace(/^www\./, '')} ↗
                      </span>
                    )}
                  </p>
                </div>
                <p class="shrink-0 text-right">
                  <span class="block font-display text-3xl font-bold text-lime">
                    <Counter value={w.metric} />
                  </span>
                  <span class="text-sm text-muted">{w.metricLabel}</span>
                </p>
              </div>
            </Wrapper>
          </article>
        </li>
      );
    })}
  </ul>
</section>
