---
import SectionHeading from '../ui/SectionHeading.astro';
import Arrow from '../ui/Arrow.astro';
import Icon from '../ui/Icon.astro';
import { services } from '../../data/home';
---

<section id="services" class="container-x scroll-mt-24 py-24 md:py-32" aria-labelledby="services-title">
  <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
    <SectionHeading id="services-title" eyebrow="Services" title="Everything your store needs to grow." />
    <a href="/services/" class="btn btn-ghost shrink-0 self-start md:self-auto" data-reveal>
      All services <Arrow />
    </a>
  </div>
  <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {services.map((s, i) => (
      <li data-reveal style={`--reveal-delay:${(i % 3) * 80}`}>
        <a
          href={`/services/${s.slug}/`}
          class="card card-spotlight group flex h-full flex-col p-8"
          data-spotlight
        >
          <span class="icon-badge">
            <Icon d={s.icon} />
          </span>
          <h3 class="mt-8 text-2xl font-semibold">{s.title}</h3>
          <p class="mt-3 text-muted">{s.summary}</p>
          <span class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-medium text-lime">
            Learn more <Arrow />
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
