---
import Arrow from '../ui/Arrow.astro';
---

<section class="container-x pb-24 md:pb-32" aria-labelledby="cta-title">
  <div
    class="cta-panel relative isolate overflow-hidden rounded-[2rem] px-6 py-20 text-center md:px-16 md:py-28"
    data-reveal
  >
    <p class="eyebrow">Let's work together</p>
    <h2 id="cta-title" class="mx-auto mt-5 max-w-3xl text-4xl font-bold sm:text-6xl">
      Ready to transform your Shopify store?
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lg text-fg/80">
      Tell us where you are and where you want to be. We reply within one business day.
    </p>
    <a href="/contact/" class="btn btn-primary btn-lg mt-10">
      Get in touch <Arrow />
    </a>
  </div>
</section>
