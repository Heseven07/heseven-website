---
/**
 * "Global Service Excellence" (as on heseven.com): copy + live world clocks on the left, and a slowly
 * rotating night-side Earth on the right. The globe is a circle-clipped strip of NASA's public-domain
 * "Black Marble" map (two copies side by side) sliding with a compositor-only transform, plus static
 * shading and atmosphere glow, so it costs no main-thread work. Lazy image, paused when off screen.
 */
import { Picture } from 'astro:assets';
import earthMap from '../../assets/earth/earth-night.jpg';
import { offices } from '../../data/home';

// HH:MM:SS, one span per digit (tabular-nums keeps every digit the same width).
const slots = ['h', 'h', ':', 'm', 'm', ':', 's', 's'];
---

<section class="container-x py-16 md:py-24" aria-labelledby="clocks-title">
  <div class="globe-card">
    <div class="relative z-10 px-6 pt-10 sm:px-10 md:px-14 md:pt-16 lg:max-w-[42rem] lg:pb-16 xl:max-w-[50rem]">
      <h2
        id="clocks-title"
        class="font-display text-3xl font-bold tracking-tight sm:text-4xl lg:whitespace-nowrap xl:text-[2.75rem]"
        data-reveal
      >
        <span class="text-lime">Global</span> Service Excellence
      </h2>
      <p class="mt-5 max-w-xl leading-relaxed text-muted" data-reveal>
        As a leading Shopify Plus development agency, we help businesses worldwide scale their eCommerce with
        innovative, robust, and future-ready solutions.
      </p>
      <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4" data-reveal>
        {offices.map((o) => (
          <li>
            <time class="clock font-display text-2xl font-bold sm:text-xl xl:text-2xl" data-tz={o.timeZone}>
              <span class="sr-only" data-sr data-city={o.city}>
                Local time in {o.city}
              </span>
              {slots.map((kind, i) =>
                kind === ':' ? (
                  <span class:list={['clock-colon', i === 5 && 'clock-sec']} aria-hidden="true">
                    :
                  </span>
                ) : (
                  <span class:list={['clock-digit', kind === 's' && 'clock-sec']} aria-hidden="true">
                    -
                  </span>
                ),
              )}
            </time>
            <p class="mt-2 text-sm text-muted">{o.city}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="globe-stage" aria-hidden="true">
      <div class="globe">
        <div class="globe-map">
          {[0, 1].map(() => (
            <Picture
              src={earthMap}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[1024, 2048]}
              sizes="(min-width: 1024px) 1472px, 960px"
              loading="lazy"
              decoding="async"
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let timeout: number | undefined;
  let io: IntersectionObserver | null = null;
  let visible = false;

  const formatters = new Map<string, Intl.DateTimeFormat>();
  const fmt = (tz: string) => {
    let f = formatters.get(tz);
    if (!f) {
      f = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hourCycle: 'h23',
        timeZone: tz,
      });
      formatters.set(tz, f);
    }
    return f;
  };

  function render(animate: boolean) {
    const now = new Date();
    document.querySelectorAll<HTMLTimeElement>('.clock[data-tz]').forEach((clock) => {
      const text = fmt(clock.dataset.tz!).format(now).replace(/\D/g, ''); // "HHMMSS"
      clock.setAttribute('datetime', now.toISOString());
      // Screen-reader text changes once a minute (HH:MM), never every second.
      const sr = clock.querySelector<HTMLElement>('[data-sr]');
      const spoken = `${text.slice(0, 2)}:${text.slice(2, 4)} in ${sr?.dataset.city}`;
      if (sr && sr.textContent !== spoken) sr.textContent = spoken;
      clock.querySelectorAll<HTMLElement>('.clock-digit').forEach((digit, i) => {
        const next = text[i] ?? '-';
        if (digit.textContent === next) return;
        digit.textContent = next;
        if (animate && !reduceMotion) {
          digit.animate(
            [
              { transform: 'translateY(-40%)', opacity: 0 },
              { transform: 'none', opacity: 1 },
            ],
            { duration: 380, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
          );
        }
      });
    });
  }

  // Tick exactly on each second boundary, only while the section is on screen and the tab is visible.
  function loop() {
    clearTimeout(timeout);
    if (!visible || document.hidden) return;
    render(true);
    timeout = window.setTimeout(loop, 1000 - (Date.now() % 1000) + 5);
  }

  function initClocks() {
    clearTimeout(timeout);
    io?.disconnect();
    const section = document.querySelector('.clock')?.closest('section');
    if (!section) return;
    render(false);
    const globe = section.querySelector<HTMLElement>('.globe');
    io = new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting);
      globe?.classList.toggle('is-spinning', visible); // spin only while on screen
      loop();
    });
    io.observe(section);
  }

  document.addEventListener('visibilitychange', loop);
  document.addEventListener('astro:page-load', initClocks);
</script>
