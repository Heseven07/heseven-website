---
import SectionHeading from '../ui/SectionHeading.astro';
import { testimonials } from '../../data/home';
---

<section class="container-x py-24 md:py-32" aria-labelledby="testimonials-title">
  <SectionHeading id="testimonials-title" eyebrow="Client stories" title="Don't take our word for it." />
  <ul class="mt-14 grid gap-6 lg:grid-cols-2">
    {testimonials.map((t, i) => (
      <li data-reveal style={`--reveal-delay:${i * 100}`}>
        <figure class="card flex h-full flex-col p-8 md:p-10">
          <div class="flex gap-1 text-lime" aria-label="Rated 5 out of 5" role="img">
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="m10 1.5 2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.8l-5.3 2.8 1-5.8L1.5 7.7l5.9-.9L10 1.5Z" />
              </svg>
            ))}
          </div>
          <blockquote class="mt-6 text-xl leading-relaxed sm:text-2xl">“{t.quote}”</blockquote>
          <figcaption class="mt-8 text-sm text-muted">
            <span class="font-medium text-fg">{t.company}</span> · {t.name}
          </figcaption>
          <dl class="mt-auto grid grid-cols-2 gap-4 border-t border-line pt-6">
            {t.stats.map((s) => (
              <div class="mt-2">
                <dt class="text-sm text-muted">{s.label}</dt>
                <dd class="font-display text-3xl font-bold">{s.value}</dd>
              </div>
            ))}
          </dl>
        </figure>
      </li>
    ))}
  </ul>
</section>
