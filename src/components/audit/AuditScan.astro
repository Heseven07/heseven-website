---
/** Decorative "sample report": a scan line sweeps a store while scores and findings appear. Transform/opacity only. */
import { auditSample as s } from '../../data/audit';
---

<figure class="as-card" aria-label="Sample audit report showing scores and example findings">
  <div class="as-bar" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
    <span>{s.url}</span>
    <em>Sample report</em>
  </div>
  <div class="as-body" aria-hidden="true">
    <span class="as-scan"></span>
    <ul class="as-scores">
      {s.scores.map((x, i) => (
        <li style={`--i:${i}`}>
          <span class="as-row">
            {x.label}
            <b>{x.value}</b>
          </span>
          <span class="as-track">
            <span class="as-fill" style={`--v:${x.value / 100}`}></span>
          </span>
        </li>
      ))}
    </ul>
    <ul class="as-findings">
      {s.findings.map((f, i) => (
        <li style={`--i:${i}`}>
          <span class:list={['as-tag', f.level === 'High' && 'as-tag--high']}>{f.level}</span>
          {f.text}
        </li>
      ))}
    </ul>
  </div>
</figure>

<style>
  .as-card {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    background: rgb(255 255 255 / 0.03);
  }
  .as-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .as-bar i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }
  .as-bar span {
    margin-left: 0.6rem;
  }
  .as-bar em {
    margin-left: auto;
    font-style: normal;
    color: var(--color-lime);
  }
  .as-body {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: 1.4rem;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .as-body {
      grid-template-columns: 1fr 1.2fr;
    }
  }
  .as-scan {
    position: absolute;
    inset: 0 0 auto;
    height: 35%;
    background: linear-gradient(180deg, transparent, rgb(181 243 107 / 0.1));
    border-bottom: 1px solid rgb(181 243 107 / 0.6);
    pointer-events: none;
    transform: translateY(-100%);
  }
  .as-scores,
  .as-findings {
    display: grid;
    align-content: start;
    gap: 0.9rem;
  }
  .as-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .as-row b {
    font-family: var(--font-display);
    color: var(--color-fg);
  }
  .as-track {
    display: block;
    height: 5px;
    margin-top: 0.35rem;
    overflow: hidden;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.08);
  }
  .as-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-violet), var(--color-lime));
    transform: scaleX(var(--v));
    transform-origin: left;
  }
  .as-findings li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .as-tag {
    flex: none;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: rgb(139 108 255 / 0.25);
    font-size: 0.7rem;
  }
  .as-tag--high {
    background: rgb(181 243 107 / 0.16);
    color: var(--color-lime);
  }

  @media (prefers-reduced-motion: no-preference) {
    .as-scan {
      animation: as-scan 5s linear infinite;
    }
    .as-fill {
      animation: as-fill 5s cubic-bezier(0.2, 0.7, 0.2, 1) infinite;
      animation-delay: calc(var(--i, 0) * 0.15s);
    }
    .as-scores li:nth-child(1) .as-fill {
      --i: 0;
    }
    .as-scores li:nth-child(2) .as-fill {
      --i: 1;
    }
    .as-scores li:nth-child(3) .as-fill {
      --i: 2;
    }
    .as-scores li:nth-child(4) .as-fill {
      --i: 3;
    }
    .as-findings li {
      animation: as-finding 5s ease infinite;
      animation-delay: calc(var(--i) * 0.5s - 1s);
    }
  }
  @keyframes as-scan {
    to {
      transform: translateY(300%);
    }
  }
  @keyframes as-fill {
    0% {
      transform: scaleX(0);
    }
    35%,
    100% {
      transform: scaleX(var(--v));
    }
  }
  @keyframes as-finding {
    0%,
    100% {
      opacity: 0.35;
    }
    20%,
    80% {
      opacity: 1;
    }
  }
</style>
