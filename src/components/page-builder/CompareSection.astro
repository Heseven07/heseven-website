---
/**
 * Comparison table: row label, a left column and a highlighted right column (usually "with Heseven" or
 * "Shopify"). A real <table> for search engines and AI; on phones each row reflows into a small card.
 */
import SectionHead from './SectionHead.astro';

interface Row {
  _key?: string;
  label: string;
  left?: string;
  right?: string;
}
interface Props {
  id: string;
  eyebrow?: string;
  heading?: string;
  lead?: string;
  leftLabel: string;
  rightLabel: string;
  rows?: Row[];
  note?: string;
}
const { id, eyebrow, heading, lead, leftLabel, rightLabel, rows = [], note } = Astro.props;
---

<section class="container-x py-20 md:py-28" aria-labelledby={heading ? id : undefined}>
  <SectionHead id={id} eyebrow={eyebrow} heading={heading} lead={lead} />
  <div class="cmp card mt-12" data-reveal>
    <table>
      {heading && <caption class="sr-only">{heading}</caption>}
      <thead>
        <tr>
          <th scope="col">
            <span class="sr-only">Compared on</span>
          </th>
          <th scope="col">{leftLabel}</th>
          <th scope="col" class="cmp-us">
            {rightLabel}
          </th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            <td data-label={leftLabel}>{r.left}</td>
            <td data-label={rightLabel} class="cmp-us">
              {r.right}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {note && <p class="mt-5 text-sm text-muted">{note}</p>}
</section>

<style>
  .cmp {
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  th,
  td {
    padding: 1.1rem 1.5rem;
    vertical-align: top;
  }
  thead th {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    border-bottom: 1px solid var(--color-line);
  }
  tbody tr + tr {
    border-top: 1px solid var(--color-line);
  }
  tbody th {
    width: 26%;
    font-weight: 600;
  }
  td {
    color: var(--color-muted);
  }
  /* The highlighted column: a lit band from header to last row. */
  .cmp-us {
    background: rgb(181 243 107 / 0.06);
    color: var(--color-fg);
  }
  thead .cmp-us {
    color: var(--color-lime);
    box-shadow: inset 0 3px 0 var(--color-lime);
  }

  @media (max-width: 767px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    tr {
      display: grid;
      padding: 1.25rem;
      gap: 0.6rem;
    }
    th,
    td {
      display: block;
      padding: 0;
      width: auto;
    }
    tbody th {
      width: auto;
      font-family: var(--font-display);
    }
    td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.15rem;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    td.cmp-us {
      padding: 0.75rem;
      border-radius: 0.75rem;
    }
    td.cmp-us::before {
      color: var(--color-lime);
    }
  }
</style>
