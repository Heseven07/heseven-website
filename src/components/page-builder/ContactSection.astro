---
/** The quote form on a builder page, with a short intro and bullet points beside it. Once per page. */
import SectionHead from './SectionHead.astro';
import QuoteForm from '../contact/QuoteForm.astro';

interface Props {
  id: string;
  eyebrow?: string;
  heading?: string;
  body?: string;
  points?: string[];
}
const { id, eyebrow, heading, body, points = [] } = Astro.props;
---

<section class="bg-ink-2 py-20 md:py-28" aria-labelledby={heading ? id : undefined}>
  <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <SectionHead id={id} eyebrow={eyebrow} heading={heading} lead={body} />
      {points.length > 0 && (
        <ul class="mt-8 grid gap-3" data-reveal>
          {points.map((p) => (
            <li class="flex gap-3">
              <span class="mt-1 text-lime" aria-hidden="true">
                ✓
              </span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
    <div class="lg:col-span-7" data-reveal>
      <QuoteForm />
    </div>
  </div>
</section>
