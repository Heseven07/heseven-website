---
import SanityImage from '../blog/SanityImage.astro';
import CtaButton from './CtaButton.astro';
import HeroVisual, { type HeroVisualKind } from './HeroVisual.astro';
import type { PageSection, Cta, SanityImage as Img } from '../../lib/sanity';

interface Props {
  section: PageSection;
  /** Fallback heading (page title) if the section has none. */
  title: string;
}
const { section, title } = Astro.props;
const s = section as PageSection & { lead?: string; primaryCta?: Cta; secondaryCta?: Cta; image?: Img };
// Without an image, large screens get an animated illustration matched to the page topic.
const topic = `${s.heading ?? ''} ${title}`;
const visual: HeroVisualKind | undefined = s.image
  ? undefined
  : /white.?label/i.test(topic)
    ? 'whitelabel'
    : /mainten|support|care/i.test(topic)
      ? 'care'
      : /assistant/i.test(topic)
        ? 'assistant'
        : 'store';
---

<section class="relative isolate z-10" aria-labelledby={`h-${s._key}`}>
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-glow"></div>
    <div class="hero-grid"></div>
  </div>
  <div
    class:list={[
      'container-x pt-36 pb-16 md:pt-44 md:pb-24',
      s.image && 'grid items-center gap-12 lg:grid-cols-2',
      visual && 'grid items-center gap-12 lg:grid-cols-12',
    ]}
  >
    <div class:list={[visual && 'lg:col-span-7']}>
      {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
      <h1
        id={`h-${s._key}`}
        class:list={[
          'mt-5 max-w-4xl text-5xl leading-[1.02] font-bold sm:text-7xl',
          visual && 'lg:text-6xl xl:text-7xl',
        ]}
      >
        {s.heading || title}
      </h1>
      {s.lead && <p class="mt-6 max-w-2xl text-lg text-muted sm:text-xl">{s.lead}</p>}
      {(s.primaryCta || s.secondaryCta) && (
        <div class="mt-10 flex flex-wrap gap-3">
          <CtaButton cta={s.primaryCta} />
          <CtaButton cta={s.secondaryCta} variant="ghost" />
        </div>
      )}
    </div>
    {visual && (
      <div class="hidden lg:col-span-5 lg:block">
        <HeroVisual kind={visual} />
      </div>
    )}
    {s.image && (
      <SanityImage
        image={s.image}
        width={1200}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="w-full rounded-[2rem] border border-line"
      />
    )}
  </div>
</section>
