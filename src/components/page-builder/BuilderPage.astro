---
/**
 * A full page built in Sanity's page builder (landing pages at /pages/<slug>, service pages at
 * /services/<slug>): title + SEO, optional fallback hero, sections, WebPage + BreadcrumbList JSON-LD
 * (+ Service on service pages).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../layout/PageHero.astro';
import Sections from './Sections.astro';
import JsonLd from '../seo/JsonLd.astro';
import { imageUrl, type LandingPage } from '../../lib/sanity';
import { SITE } from '../../config/site';

interface Props {
  page: LandingPage;
  /** URL prefix, e.g. "pages" or "services". */
  base: string;
  /** Extra breadcrumb between Home and the page, e.g. { name: 'Services', path: '/services' }. */
  parent?: { name: string; path: string };
}

const { page, base, parent } = Astro.props;
const url = new URL(`/${base}/${page.slug}`, Astro.site).href;
const hasHero = page.sections[0]?._type === 'sectionHero';
// Migrated pages keep Shopify's "<title> – Heseven" format; new pages use "<title> | Heseven".
const baseTitle = (page.seo?.title ?? page.title).trim();
const pageTitle = page.legacy ? `${baseTitle} – ${SITE.name}` : `${baseTitle} | ${SITE.name}`;
const hero = page.sections.find((s) => s._type === 'sectionHero') as { lead?: string } | undefined;
const description = page.seo?.description ?? hero?.lead ?? SITE.description;
const shareImage = page.seo?.ogImage
  ? imageUrl(page.seo.ogImage).width(1200).height(630).fit('crop').format('jpg').url()
  : undefined;

const crumbs = [
  { name: 'Home', item: `${SITE.url}/` },
  ...(parent ? [{ name: parent.name, item: `${SITE.url}${parent.path}` }] : []),
  { name: page.title, item: url },
];
const schema = [
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: baseTitle,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  // Service pages also describe the service itself, offered by the organisation.
  ...(base === 'services'
    ? [
        {
          '@type': 'Service',
          '@id': `${url}#service`,
          name: page.title,
          serviceType: page.title,
          description,
          url,
          provider: { '@id': `${SITE.url}/#organization` },
          areaServed: ['United Kingdom', 'United States', 'Europe', 'Australia', 'India'],
        },
      ]
    : []),
  {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, ...c })),
  },
];
---

<style>
  /* Service pages are long: let the browser skip layout/paint of sections below the hero and proof
     strip until they near the viewport (keeps LCP inside budget; content stays in the DOM for SEO). */
  .pb-lazy > :global(section:nth-of-type(n + 3)) {
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
  }
</style>

<BaseLayout
  title={pageTitle}
  rawTitle
  description={description}
  image={shareImage}
  noindex={page.seo?.noindex}
>
  {!hasHero && <PageHero title={page.title} lead={page.seo?.description} />}
  {base === 'services' ? (
    <div class="pb-lazy">
      <Sections sections={page.sections} title={page.title} />
    </div>
  ) : (
    <Sections sections={page.sections} title={page.title} />
  )}
  <JsonLd data={schema} />
</BaseLayout>
