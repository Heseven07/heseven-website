---
/**
 * Renders a landing page's sections (from Sanity) in order. One component per section type;
 * all styling comes from the site's design system (cards, icons, counters, FAQ, CTA panel).
 */
import HeroSection from './HeroSection.astro';
import SectionHead from './SectionHead.astro';
import CtaButton from './CtaButton.astro';
import PortableTextBody from '../blog/PortableTextBody.astro';
import PointsInfographic, { type Point } from './PointsInfographic.astro';
import ProseSplit from './ProseSplit.astro';
import SanityImage from '../blog/SanityImage.astro';
import FitSection from './FitSection.astro';
import PitfallsSection from './PitfallsSection.astro';
import CompareSection from './CompareSection.astro';
import PlansSection from './PlansSection.astro';
import LinksSection from './LinksSection.astro';
import ContactSection from './ContactSection.astro';
import Testimonials from '../sections/Testimonials.astro';
import Icon from '../ui/Icon.astro';
import Counter from '../ui/Counter.astro';
import JsonLd from '../seo/JsonLd.astro';
import { icons, type IconName } from '../../data/icons';
import type { PageSection, PortableBlock, Cta, SanityImage as Img } from '../../lib/sanity';

interface Props {
  sections: PageSection[];
  title: string;
}
const { sections, title } = Astro.props;

/**
 * Rich text made only of "subheading + paragraphs" groups (at least two) → points for the infographic.
 * Anything else (lists, images, text before the first subheading) stays plain prose.
 */
function toPoints(body: PortableBlock[] = []): Point[] | undefined {
  const points: Point[] = [];
  for (const b of body) {
    const style = b.style ?? 'normal';
    if (b._type !== 'block' || (b as { listItem?: string }).listItem) return;
    if (/^h[2-4]$/.test(style))
      points.push({ title: (b.children ?? []).map((c) => c.text ?? '').join(''), body: [] });
    else if (style === 'normal' && points.length) points.at(-1)!.body.push(b);
    else return;
  }
  return points.length >= 2 && points.every((p) => p.title && p.body.length) ? points : undefined;
}

type Any = PageSection & Record<string, any>; // eslint-disable-line @typescript-eslint/no-explicit-any
const cols: Record<number, string> = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};
---

{sections.map((raw, i) => {
  const s = raw as Any;
  const id = `h-${s._key}`;
  const alt = i % 2 === 1;
  switch (s._type) {
    case 'sectionHero':
      return <HeroSection section={s} title={title} />;

    case 'sectionRichText': {
      const points = toPoints(s.body as PortableBlock[]);
      if (points)
        return <PointsInfographic id={id} eyebrow={s.eyebrow} heading={s.heading} points={points} />;
      // Only plain paragraphs → text beside a highlight card instead of a half-empty row.
      const blocks = (s.body ?? []) as PortableBlock[];
      const plain =
        blocks.length > 0 &&
        blocks.every(
          (b) =>
            b._type === 'block' &&
            (b.style ?? 'normal') === 'normal' &&
            !(b as { listItem?: string }).listItem,
        );
      if (plain) return <ProseSplit id={id} eyebrow={s.eyebrow} heading={s.heading} body={blocks} />;
      return (
        <section class="container-x py-20 md:py-28" aria-labelledby={s.heading ? id : undefined}>
          <SectionHead id={id} eyebrow={s.eyebrow} heading={s.heading} />
          <PortableTextBody
            blocks={(s.body ?? []) as PortableBlock[]}
            class="mt-10 max-w-3xl"
            headingLevel={s.heading ? 3 : 2}
          />
        </section>
      );
    }

    case 'sectionFeatures':
      return (
        <section
          class:list={['py-20 md:py-28', alt && 'bg-ink-2']}
          aria-labelledby={s.heading ? id : undefined}
        >
          <div class="container-x">
            <SectionHead id={id} eyebrow={s.eyebrow} heading={s.heading} lead={s.lead} />
            <ul class:list={['mt-12 grid gap-4', cols[s.columns ?? 3]]}>
              {(s.items ?? []).map((it: Any, j: number) => {
                const inner = (
                  <>
                    {it.image ? (
                      <SanityImage
                        image={it.image as Img}
                        width={640}
                        sizes="(min-width: 1024px) 33vw, 100vw"
                        class="mb-6 w-full rounded-2xl"
                      />
                    ) : (
                      it.icon &&
                      icons[it.icon as IconName] && (
                        <span class="icon-badge mb-6">
                          <Icon d={icons[it.icon as IconName]} />
                        </span>
                      )
                    )}
                    <h3 class="text-xl font-semibold">{it.title}</h3>
                    {it.body && <p class="mt-3 text-muted">{it.body}</p>}
                  </>
                );
                return (
                  <li data-reveal style={`--reveal-delay:${(j % 3) * 80}`}>
                    {it.href ? (
                      <a
                        href={it.href}
                        class="card card-spotlight group flex h-full flex-col p-8"
                        data-spotlight
                      >
                        {inner}
                      </a>
                    ) : (
                      <div class="card card-spotlight group h-full p-8" data-spotlight>
                        {inner}
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      );

    case 'sectionStats':
      return (
        <section class="container-x py-16 md:py-20" aria-labelledby={s.heading ? id : undefined}>
          <SectionHead id={id} eyebrow={s.eyebrow} heading={s.heading} />
          <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-line bg-line md:grid-cols-4">
            {(s.items ?? []).map((st: Any) => (
              <div class="bg-ink p-6 md:p-8">
                <dt class="text-sm text-muted">{st.label}</dt>
                <dd class="mt-2 font-display text-4xl font-bold md:text-5xl">
                  <Counter value={st.value} />
                </dd>
              </div>
            ))}
          </dl>
        </section>
      );

    case 'sectionImageText':
      return (
        <section
          class:list={['py-20 md:py-28', alt && 'bg-ink-2']}
          aria-labelledby={s.heading ? id : undefined}
        >
          <div class="container-x grid items-center gap-12 lg:grid-cols-2">
            <div class:list={[s.imageSide === 'left' && 'lg:order-2']}>
              <SectionHead id={id} eyebrow={s.eyebrow} heading={s.heading} />
              <PortableTextBody
                blocks={(s.body ?? []) as PortableBlock[]}
                class="mt-8"
                headingLevel={s.heading ? 3 : 2}
              />
              {s.cta && (
                <div class="mt-8">
                  <CtaButton cta={s.cta as Cta} />
                </div>
              )}
            </div>
            {s.image && (
              <SanityImage
                image={s.image as Img}
                width={1200}
                sizes="(min-width: 1024px) 50vw, 100vw"
                class="w-full rounded-[2rem] border border-line"
              />
            )}
          </div>
        </section>
      );

    case 'sectionSteps':
      return (
        <section
          class:list={['py-20 md:py-28', alt && 'bg-ink-2']}
          aria-labelledby={s.heading ? id : undefined}
        >
          <div class="container-x">
            <SectionHead id={id} eyebrow={s.eyebrow} heading={s.heading} lead={s.lead} />
            <ol class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {(s.steps ?? []).map((st: Any, j: number) => (
                <li class="card p-8" data-reveal style={`--reveal-delay:${(j % 3) * 80}`}>
                  <span class="font-display text-sm text-lime">{String(j + 1).padStart(2, '0')}</span>
                  <h3 class="mt-3 text-xl font-semibold">{st.title}</h3>
                  {st.body && <p class="mt-2 text-muted">{st.body}</p>}
                </li>
              ))}
            </ol>
          </div>
        </section>
      );

    case 'sectionFaq':
      return (
        <section class="container-x py-20 md:py-28" aria-labelledby={id}>
          <div class="grid gap-12 md:grid-cols-12">
            <div class="md:col-span-4">
              <SectionHead
                id={id}
                eyebrow={s.eyebrow ?? 'FAQ'}
                heading={s.heading ?? 'Questions, answered.'}
              />
            </div>
            <div class="md:col-span-8">
              {(s.items ?? []).map((f: Any, j: number) => (
                <details class="faq" name={`faq-${s._key}`} open={j === 0}>
                  <summary>
                    <span class="font-display text-lg font-semibold sm:text-xl">{f.question}</span>
                    <span class="faq-icon" aria-hidden="true" />
                  </summary>
                  <p class="pb-6 whitespace-pre-line text-muted">{f.answer}</p>
                </details>
              ))}
            </div>
          </div>
          <JsonLd
            data={{
              '@type': 'FAQPage',
              mainEntity: (s.items ?? []).map((f: Any) => ({
                '@type': 'Question',
                name: f.question,
                acceptedAnswer: { '@type': 'Answer', text: f.answer },
              })),
            }}
          />
        </section>
      );

    case 'sectionFit':
      return <FitSection id={id} {...s} />;

    case 'sectionPitfalls':
      return <PitfallsSection id={id} {...s} />;

    case 'sectionCompare':
      return <CompareSection id={id} {...s} leftLabel={s.leftLabel} rightLabel={s.rightLabel} />;

    case 'sectionPlans':
      return <PlansSection id={id} {...s} />;

    case 'sectionTestimonials':
      return <Testimonials />;

    case 'sectionLinks':
      return <LinksSection id={id} {...s} />;

    case 'sectionContact':
      return <ContactSection id={id} {...s} />;

    case 'sectionCta':
      return (
        <section class="container-x py-20 md:py-28" aria-labelledby={id}>
          <div
            class="cta-panel relative isolate overflow-hidden rounded-[2rem] px-6 py-20 text-center md:px-16 md:py-24"
            data-reveal
          >
            {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
            <h2 id={id} class="mx-auto mt-5 max-w-3xl text-4xl font-bold sm:text-5xl">
              {s.heading ?? 'Ready to grow your Shopify store?'}
            </h2>
            {s.body && <p class="mx-auto mt-6 max-w-xl text-lg text-fg/80">{s.body}</p>}
            <div class="mt-10">
              <CtaButton cta={(s.cta as Cta) ?? { label: 'Get in touch', href: '/pages/contact-us' }} />
            </div>
          </div>
        </section>
      );

    default:
      return null;
  }
})}
