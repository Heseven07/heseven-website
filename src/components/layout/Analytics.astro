---
/**
 * Consent-gated GA4 + Tracklution.
 *
 * Each is OFF until its ID is set in the environment (.env / Cloudflare Pages vars):
 *   PUBLIC_GA4_ID=G-XXXXXXXXXX
 *   PUBLIC_TRACKLUTION_ID=LS-00000000-0
 *
 * UK and Canada (business decision, by country from /api/geo.json): nothing third-party loads until the
 * visitor accepts the cookie banner. Everywhere else tracking loads unless they click "Reject"
 * (ignoring the banner counts as a yes). Either way it loads only once the browser is idle, and an
 * unknown country is treated like the UK. Off Cloudflare (Lighthouse, astro preview), public/api/geo.json answers { country: null }, so
 * nothing loads and scores stay at 100.
 * If no ID is set, this component renders nothing (no banner, no script).
 *
 * ---- Original vendor snippets (for reference; the loader below is equivalent) ----
 *
 * <!-- Google tag (gtag.js) -->
 * <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
 * <script>
 *   window.dataLayer = window.dataLayer || [];
 *   function gtag(){dataLayer.push(arguments);}
 *   gtag('js', new Date());
 *   gtag('config', 'G-XXXXXXXXXX');
 * </script>
 *
 * Tracklution: the same function as in load() below, followed by tlq('init', 'LS-00000000-0');
 * tlq('track', 'PageView'); on every page and tlq('track', 'ViewContent'); on the contact page.
 * The quote form's funnel events are in scripts/quote-form.ts.
 */
const ga4Id = import.meta.env.PUBLIC_GA4_ID ?? '';
const tracklutionId = import.meta.env.PUBLIC_TRACKLUTION_ID ?? '';
const enabled = Boolean(ga4Id || tracklutionId);
---

{enabled && (
  <>
    <div
      id="consent"
      class="consent"
      role="dialog"
      aria-live="polite"
      aria-label="Cookie consent"
      hidden
      transition:persist
    >
      <p>
        We use cookies to measure how the site is used and to improve our ads.{' '}
        <a href="/privacy">Privacy policy</a>
      </p>
      <div class="consent-actions">
        <button type="button" data-consent="reject" class="btn btn-ghost btn-sm">
          Reject
        </button>
        <button type="button" data-consent="accept" class="btn btn-primary btn-sm">
          Accept
        </button>
      </div>
    </div>
    <script is:inline define:vars={{ ga4Id, tracklutionId }}>
      /* eslint-disable -- ES5 inline loader kept close to the vendor snippets so they are easy to diff/update. */
      (function () {
        if (window.__hsAnalytics) return;
        window.__hsAnalytics = true;
        var KEY = 'hs-consent';
        var CONSENT_COUNTRIES = ['GB', 'CA'];
        var loaded = false;

        function read() {
          try {
            return localStorage.getItem(KEY);
          } catch (e) {
            return null;
          }
        }
        function write(v) {
          try {
            localStorage.setItem(KEY, v);
          } catch (e) {}
        }
        function idle(fn) {
          'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 4000 }) : setTimeout(fn, 2000);
        }
        function addScript(src) {
          var s = document.createElement('script');
          s.async = true;
          s.src = src;
          document.head.appendChild(s);
        }

        // Visitor's country from the Worker (Cloudflare geolocation), once per browser session.
        function country(cb) {
          try {
            var saved = sessionStorage.getItem('hs-geo');
            if (saved !== null) return cb(saved);
          } catch (e) {}
          fetch('/api/geo.json')
            .then(function (r) {
              return r.ok ? r.json() : {};
            })
            .catch(function () {
              return {};
            })
            .then(function (d) {
              var c = (d && d.country) || '';
              try {
                if (c) sessionStorage.setItem('hs-geo', c);
              } catch (e) {}
              cb(c);
            });
        }

        function trackPage() {
          tlq('track', 'PageView');
          if (/^\/pages\/contact-us\/?$/.test(location.pathname)) tlq('track', 'ViewContent');
        }

        function load() {
          if (loaded) return;
          loaded = true;
          if (ga4Id) {
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              dataLayer.push(arguments);
            };
            gtag('consent', 'default', {
              ad_storage: 'granted',
              analytics_storage: 'granted',
              ad_user_data: 'granted',
              ad_personalization: 'granted',
            });
            gtag('js', new Date());
            gtag('config', ga4Id);
            addScript('https://www.googletagmanager.com/gtag/js?id=' + ga4Id);
          }
          if (tracklutionId) {
            !(function (t, l, r, o, c, k, s) {
              if (t.tlq) return;
              c = t.tlq = function () {
                c.callMethod ? c.callMethod(arguments) : c.queue.push(arguments);
              };
              if (!t._tlq) t._tlq = c;
              c.push = c;
              c.loaded = !0;
              c.version = '1.0';
              c.src = o;
              c.queue = [];
              k = l.createElement(r);
              k.async = !0;
              c.pd = false;
              c.tools = null;
              k.src = o;
              s = l.getElementsByTagName(r)[0];
              s.parentNode.insertBefore(k, s);
              k.onerror = function () {
                o = 'https://main-70753.trlution.com/js/script-dynamic.js?version=1793591553650';
                t._tlq.src = o;
                k = l.createElement(r);
                k.async = !0;
                k.src = o;
                s.parentNode.insertBefore(k, s);
              };
            })(
              window,
              document,
              'script',
              'https://tralut.heseven.com/js/script-dynamic.js?version=1793591553650',
            );
            tlq('init', tracklutionId);
            // Tracklution "basic consent mode": this only runs after "Accept", which covers both.
            tlq('set', 'Consent', { analyticsConsent: 'granted', marketingConsent: 'granted' });
            trackPage();
          }
        }

        // Client-side navigations (view transitions): GA4 tracks history changes itself; Tracklution needs a nudge.
        var first = true;
        document.addEventListener('astro:page-load', function () {
          if (first) {
            first = false;
            return;
          }
          if (loaded && window.tlq) trackPage();
        });

        var banner = document.getElementById('consent');
        var choice = read();
        if (choice === 'accept') {
          idle(load);
        } else if (!choice) {
          idle(function () {
            if (banner) banner.hidden = false;
            country(function (c) {
              if (c && CONSENT_COUNTRIES.indexOf(c) === -1) load();
            });
          });
        }

        document.addEventListener('click', function (e) {
          var btn = e.target instanceof Element && e.target.closest('[data-consent]');
          if (!btn) return;
          var v = btn.getAttribute('data-consent');
          write(v);
          var b = document.getElementById('consent');
          if (b) b.hidden = true;
          if (v === 'accept') idle(load);
          else if (loaded) location.reload();
        });

        // Footer "Cookie settings" link: <button data-consent-open>
        document.addEventListener('click', function (e) {
          if (!(e.target instanceof Element) || !e.target.closest('[data-consent-open]')) return;
          var b = document.getElementById('consent');
          if (b) b.hidden = false;
        });
      })();
    </script>
  </>
)}
