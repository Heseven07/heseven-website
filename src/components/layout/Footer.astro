---
/**
 * Footer — same design as heseven.com: rounded dark panel with the green light-beam background image,
 * Information / Services / Build & Migrate / Convert & Optimise columns, big "heseven" wordmark,
 * Follow Us pills.
 * On mobile, the link columns collapse into accordions (open on desktop).
 */
import { Image } from 'astro:assets';
import footerBg from '../../assets/brand/footer-bg.png';
import { SITE } from '../../config/site';
import { footerLinks } from '../../data/home';

const year = new Date().getFullYear();
const trackingEnabled = Boolean(import.meta.env.PUBLIC_GA4_ID || import.meta.env.PUBLIC_META_PIXEL_ID);
const social = [
  { label: 'Facebook', href: SITE.social.facebook },
  { label: 'Instagram', href: SITE.social.instagram },
  { label: 'LinkedIn', href: SITE.social.linkedin },
];
const columns = [
  { id: 'information', title: 'Information', links: footerLinks.information },
  { id: 'services', title: 'Services', links: footerLinks.services },
  { id: 'build-migrate', title: 'Build & Migrate', links: footerLinks.buildMigrate },
  { id: 'convert-optimise', title: 'Convert & Optimise', links: footerLinks.convertOptimise },
];
---

<footer class="container-x pt-16 pb-6 md:pt-24">
  <div class="ft-panel">
    <Image
      src={footerBg}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="(min-width: 1700px) 1636px, 100vw"
      loading="lazy"
      class="ft-bg"
    />

    <div class="relative px-6 pt-6 sm:px-10 md:px-12 md:pt-20">
      <!-- 1. Link columns: accordions on mobile, open columns on desktop -->
      <div class="grid gap-x-10 md:grid-cols-2 md:gap-y-14 xl:grid-cols-4">
        {columns.map((col) => (
          <details class="ft-col" open data-ft-acc>
            <summary class="ft-summary">
              <h2 class="ft-heading">{col.title}</h2>
              <span class="ft-plus" aria-hidden="true" />
            </summary>
            <nav aria-label={col.title}>
              <ul class="flex flex-col gap-5 pb-8 md:mt-8 md:pb-0">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="ft-link">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        ))}
      </div>

      <!-- 2. Wordmark (left) + contact details and social links stacked on its right (below it on mobile) -->
      <div class="mt-12 flex flex-col gap-10 pb-10 md:mt-16 md:pb-12 lg:flex-row lg:items-end lg:justify-between">
        <p class="ft-wordmark shrink-0" aria-hidden="true">
          heseven
        </p>
        <div class="flex flex-col gap-10 lg:max-w-sm lg:pb-2">
          <div>
            <h2 class="text-sm">Contact Us:</h2>
            <address class="mt-4 flex flex-col gap-4 not-italic">
              <p class="flex gap-3 leading-relaxed">
                <svg class="ft-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"></path>
                </svg>
                <span>
                  {SITE.address.streetAddress}, {SITE.address.addressLocality}, {SITE.address.addressRegion},{' '}
                  {SITE.address.postalCode}, United Kingdom
                </span>
              </p>
              <p class="flex gap-3">
                <svg class="ft-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3 5h18v14H3V5Zm2 2v.5l7 4.5 7-4.5V7H5Zm14 2.85-7 4.5-7-4.5V17h14V9.85Z"></path>
                </svg>
                <a href={`mailto:${SITE.email}`} class="ft-link text-fg">
                  {SITE.email}
                </a>
              </p>
            </address>
          </div>
          <div>
            <h2 class="text-sm">Follow Us:</h2>
            <ul class="mt-4 flex flex-wrap gap-2.5">
              {social.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" class="ft-pill">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="relative flex flex-col items-center gap-3 border-t border-white/10 px-6 py-6 text-sm sm:px-10 md:flex-row md:justify-between md:px-12">
      <p>
        © {year}, {SITE.legalName}.
      </p>
      <ul class="flex flex-wrap gap-5 text-fg/70">
        <li>
          <a href="/privacy" class="ft-link">
            Privacy
          </a>
        </li>
        <li>
          <a href="/terms" class="ft-link">
            Terms
          </a>
        </li>
        {trackingEnabled && (
          <li>
            <button type="button" data-consent-open class="ft-link">
              Cookie settings
            </button>
          </li>
        )}
      </ul>
    </div>
  </div>
</footer>

<script>
  // Mobile: start the link columns collapsed. Desktop: always open (summary clicks ignored).
  const desktop = matchMedia('(min-width: 768px)');
  function initFooterAccordions() {
    document.querySelectorAll<HTMLDetailsElement>('[data-ft-acc]').forEach((d) => {
      d.open = desktop.matches;
      if (d.dataset.ready) return;
      d.dataset.ready = 'true';
      d.querySelector('summary')?.addEventListener('click', (e) => {
        if (desktop.matches) e.preventDefault();
      });
    });
  }
  desktop.addEventListener('change', initFooterAccordions);
  document.addEventListener('astro:page-load', initFooterAccordions);
</script>
