---
import Logo from '../ui/Logo.astro';
import { SITE } from '../../config/site';
import { nav, services } from '../../data/home';

const year = new Date().getFullYear();
const trackingEnabled = Boolean(import.meta.env.PUBLIC_GA4_ID || import.meta.env.PUBLIC_META_PIXEL_ID);
---

<!--
  Glass footer: an animated rainbow "aurora" (pre-blurred, transform-only motion) sits behind a
  frosted panel; text sits on the panel. Aurora only animates while the footer is on screen
  ([data-inview] → .is-inview, see scripts/motion.ts) and never for reduced-motion users.
-->
<footer class="site-footer relative isolate overflow-hidden pt-24 pb-8 md:pt-32" data-inview>
  <div class="aurora" aria-hidden="true">
    <span class="aurora-ring"></span>
    <span class="aurora-blob aurora-blob--1"></span>
    <span class="aurora-blob aurora-blob--2"></span>
    <span class="aurora-blob aurora-blob--3"></span>
    <span class="aurora-blob aurora-blob--4"></span>
    <span class="aurora-blob aurora-blob--5"></span>
  </div>

  <div class="container-x">
    <div class="glass-panel" data-spotlight>
      <div class="grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <Logo />
          <p class="mt-5 max-w-sm text-fg/75">
            Shopify Plus Partner agency designing, building and growing e-commerce brands since{' '}
            {SITE.foundingYear}.
          </p>
          <a
            href={`mailto:${SITE.email}`}
            class="mt-6 inline-block font-display text-2xl font-semibold hover:text-lime"
          >
            {SITE.email}
          </a>
          <address class="mt-6 text-sm leading-relaxed text-fg/70 not-italic">
            {SITE.legalName}
            <br />
            {SITE.address.streetAddress}, {SITE.address.addressLocality}
            <br />
            {SITE.address.addressRegion}, {SITE.address.postalCode}, United Kingdom
          </address>
        </div>
        <nav aria-label="Services" class="md:col-span-3">
          <h2 class="footer-title">Services</h2>
          <ul class="footer-list">
            {services.map((s) => (
              <li>
                <a href={`/services/${s.slug}`}>{s.title}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Company" class="md:col-span-2">
          <h2 class="footer-title">Company</h2>
          <ul class="footer-list">
            {nav.map((n) => (
              <li>
                <a href={n.href}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="md:col-span-2">
          <h2 class="footer-title">Follow</h2>
          <ul class="footer-list">
            <li>
              <a href={SITE.social.linkedin} rel="noopener" target="_blank">
                LinkedIn
              </a>
            </li>
            <li>
              <a href={SITE.social.instagram} rel="noopener" target="_blank">
                Instagram
              </a>
            </li>
            <li>
              <a href={SITE.social.facebook} rel="noopener" target="_blank">
                Facebook
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 text-sm text-fg/70 sm:flex-row sm:items-center sm:justify-between">
        <p>
          © {year} {SITE.legalName}. All rights reserved.
        </p>
        <ul class="flex flex-wrap gap-6">
          <li>
            <a href="/privacy" class="transition-colors hover:text-lime">
              Privacy
            </a>
          </li>
          <li>
            <a href="/terms" class="transition-colors hover:text-lime">
              Terms
            </a>
          </li>
          {trackingEnabled && (
            <li>
              <button type="button" data-consent-open class="transition-colors hover:text-lime">
                Cookie settings
              </button>
            </li>
          )}
        </ul>
      </div>
    </div>
  </div>
</footer>
